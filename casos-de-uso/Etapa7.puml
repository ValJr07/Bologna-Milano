@startuml
left to right direction
skinparam shadowing false
skinparam actor {
  BackgroundColor White
  BorderColor #1f2a5c
  FontColor #1f2a5c
}
skinparam usecase {
  BackgroundColor #e8f1f5
  BorderColor #0b5c80
  FontColor #1f2a5c
}
skinparam rectangle {
  BorderColor #1f2a5c
  FontColor #1f2a5c
}
skinparam ArrowColor #0b5c80

title Etapa 7 - Diagrama de casos de uso

actor Jogador

rectangle "Bolonha e Milano" {
  usecase "Iniciar novo jogo" as UC1
  usecase "Ver status da cidade" as UC2
  usecase "Acessar mercado" as UC3
  usecase "Acessar agricultura" as UC4
  usecase "Acessar governo" as UC5
  usecase "Acessar construções" as UC6
  usecase "Encerrar turno" as UC7
  usecase "Ver classificação" as UC8
  usecase "Ver informações sobre o jogo" as UC9
  usecase "Sair do jogo" as UC10

  usecase "Comprar grãos" as UC31
  usecase "Vender grãos" as UC32
  usecase "Comprar terras" as UC33
  usecase "Vender terras" as UC34

  usecase "Colher (processar safra)" as UC41
  usecase "Distribuir alimentos" as UC42

  usecase "Arrecadar impostos" as UC51
  usecase "Definir taxa de imposto" as UC52
  usecase "Definir nível de justiça" as UC53

  usecase "Recrutar soldados" as UC61
  usecase "Construir" as UC62

  usecase "Fechar o ano (promover títulos)" as UC71
  usecase "Declarar vencedor" as UC72
}

Jogador --> UC1
Jogador --> UC2
Jogador --> UC3
Jogador --> UC4
Jogador --> UC5
Jogador --> UC6
Jogador --> UC7
Jogador --> UC8
Jogador --> UC9
Jogador --> UC10

UC31 .> UC3 : <<extend>>
UC32 .> UC3 : <<extend>>
UC33 .> UC3 : <<extend>>
UC34 .> UC3 : <<extend>>

UC41 .> UC4 : <<extend>>
UC42 .> UC4 : <<extend>>

UC51 .> UC5 : <<extend>>
UC52 .> UC5 : <<extend>>
UC53 .> UC5 : <<extend>>

UC61 .> UC6 : <<extend>>
UC62 .> UC6 : <<extend>>

UC71 .> UC7 : <<extend>>
UC72 .> UC71 : <<extend>>

note right of UC71
  só quando quem encerrou é o
  último jogador da rodada
end note
note right of UC72
  só se alguém virou Rei/Rainha
  ou 1410 acabou
end note
@enduml
