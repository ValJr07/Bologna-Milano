@startuml
left to right direction
skinparam shadowing false
skinparam actor {
  BackgroundColor White
  BorderColor #1f2a5c
  FontColor #1f2a5c
}
skinparam usecase {
  BackgroundColor #e8f1f5
  BorderColor #0b5c80
  FontColor #1f2a5c
}
skinparam rectangle {
  BorderColor #1f2a5c
  FontColor #1f2a5c
}
skinparam ArrowColor #0b5c80

title Etapa 3 - Diagrama de casos de uso

actor Jogador

rectangle "Bolonha e Milano" {
  usecase "Iniciar novo jogo" as UC1
  usecase "Ver status da cidade" as UC2
  usecase "Acessar mercado" as UC3
  usecase "Ver informações sobre o jogo" as UC4
  usecase "Sair do jogo" as UC5

  usecase "Comprar grãos" as UC31
  usecase "Vender grãos" as UC32
  usecase "Comprar terras" as UC33
  usecase "Vender terras" as UC34
}

Jogador --> UC1
Jogador --> UC2
Jogador --> UC3
Jogador --> UC4
Jogador --> UC5

UC31 .> UC3 : <<extend>>
UC32 .> UC3 : <<extend>>
UC33 .> UC3 : <<extend>>
UC34 .> UC3 : <<extend>>
@enduml
