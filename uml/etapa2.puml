@startuml
skinparam classAttributeIconSize 0
skinparam classFontStyle bold
skinparam shadowing false
skinparam class {
  BackgroundColor White
  BorderColor #1f2a5c
  HeaderBackgroundColor #1f2a5c
  FontColor #1f2a5c
}
skinparam ArrowColor #0b5c80
skinparam NoteBackgroundColor #fdf3e1
skinparam NoteBorderColor #fdf3e1

title Etapa 2 - Diagrama de classes

class Main <<módulo>> {
  + main(): None
}

class Menu {
  - _em_execucao: bool
  - _jogador: Jogador | None
  - _cidade: Cidade | None
  --
  + executar(): None
  - _exibir_opcoes(): None
  - _ler_opcao(): int
  - _processar_opcao(opcao: int): None
  - _iniciar_novo_jogo(): None
  - _exibir_status_cidade(): None
  - _exibir_sobre(): None
  - _ler_texto(pergunta: str): str | None
}

class Cidade {
  - _nome: str
  - _dono: Jogador
  - _ano_atual: int
  --
  + Cidade(nome: str, dono: Jogador)
  + avancar_ano(): None
  + exibir_status(): None
}

class Jogador {
  - _nome: str
  - _titulo: str
  --
  + Jogador(nome: str)
  + nome: str «somente leitura»
  + titulo: str «somente leitura»
}

Main ..> Menu : cria e usa
Menu --> "0..1" Cidade : cidade
Menu --> "0..1" Jogador : jogador
Cidade --> "1" Jogador : dono

note bottom of Menu
  Menu guarda Jogador e Cidade (None até o "Novo jogo").
  Cidade guarda o seu dono. Main só depende de Menu.
end note
@enduml
